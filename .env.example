# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Primary LLM & Whisper)
GROQ_API_KEY=your_groq_api_key

# --- Email for Lead Notifications (Standard SMTP) ---
# Set these to enable automated lead emails notifying futureai4all@gmail.com
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- ElevenLabs Premium Voice ---
# Primary high-quality TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Image Generation APIs (Optional Fallbacks) ---
# Pollinations.ai (FREE) is the default fallback and requires no key.
FAL_KEY=your_fal_ai_key
# HF_TOKEN=your_huggingface_token
# REPLICATE_API_TOKEN=your_replicate_token

# Public URL for local generated image access
PUBLIC_BASE_URL=https://your-app-name.onrender.com

# Optional: GitHub Personal Access Token (for conversation log pushing)
# GITHUB_TOKEN=your_github_token_here
# GITHUB_REPO=PinnacleAI/mcpaichatbot

# Server Environment
PORT=8000
PYTHONUNBUFFERED=1
ENABLE_CONVERSATION_LOGGING=true
